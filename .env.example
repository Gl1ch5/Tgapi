# Get these at https://my.telegram.org -> API development tools.
# Can also be set from the panel on first run (Settings).
TG_API_ID=
TG_API_HASH=

# Where the SQLite database, secret key and sessions live.
DATA_DIR=./data

# Public URL of the panel (used in docs/examples). Optional.
PUBLIC_URL=https://tg.example.com

HOST=127.0.0.1
PORT=8080
